<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">

    <Button android:id="@+id/btnOpenPdf" style="@style/ToolButton" android:text="Open PDF" />
    <ImageView android:id="@+id/pdfPageImage" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:scaleType="fitCenter" android:background="#1A1A1A" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnPrevPage" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:text="Previous" />
        <Button android:id="@+id/btnNextPage" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:text="Next" />
    </LinearLayout>
    <TextView android:id="@+id/pdfPageLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/silver" android:gravity="center" android:layout_marginTop="4dp" />
</LinearLayout>
