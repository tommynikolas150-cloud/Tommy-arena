<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">

    <EditText android:id="@+id/categoryInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Category (e.g. Rent, Food)" android:textColor="@color/text_light" android:textColorHint="#777777" />
    <EditText android:id="@+id/budgetInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Monthly budget amount" android:inputType="numberDecimal" android:textColor="@color/text_light" android:textColorHint="#777777" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnAddCategory" style="@style/ToolButton" android:text="Add Category" android:layout_marginTop="8dp" />
    <ListView android:id="@+id/categoryList" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="16dp" android:divider="#333333" android:dividerHeight="1dp" />
</LinearLayout>
