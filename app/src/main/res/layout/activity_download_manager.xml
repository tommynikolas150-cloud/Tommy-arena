<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">

    <EditText android:id="@+id/downloadUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="https://example.com/file.pdf" android:inputType="textUri" android:textColor="@color/text_light" android:textColorHint="#777777" />
    <EditText android:id="@+id/downloadNameInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="File name (optional)" android:textColor="@color/text_light" android:textColorHint="#777777" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnStartDownload" style="@style/ToolButton" android:text="Download" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Downloads go to your device's Downloads folder and appear in the system notification shade." android:textColor="@color/silver" android:textSize="12sp" android:layout_marginTop="16dp" />
</LinearLayout>
