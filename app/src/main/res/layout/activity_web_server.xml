<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp" android:gravity="center">

    <TextView android:id="@+id/serverStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/purple_primary" android:textSize="18sp" android:gravity="center" android:layout_marginBottom="20dp" />

    <Button android:id="@+id/btnStartServer" style="@style/ToolButton" android:text="Start Server" />
    <Button android:id="@+id/btnStopServer" style="@style/ToolButton" android:text="Stop Server" android:layout_marginTop="12dp" />

</LinearLayout>
