<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp" android:gravity="center">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Choose a folder to compress into a .zip file, which you can then share or save."
        android:textColor="@color/text_light" android:textSize="15sp" android:gravity="center" android:layout_marginBottom="20dp" />

    <Button android:id="@+id/btnChooseFolder" style="@style/ToolButton" android:text="Choose Folder to Zip" />
    <TextView android:id="@+id/compressStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/purple_primary" android:textSize="14sp" android:gravity="center" android:layout_marginTop="16dp" />
</LinearLayout>
