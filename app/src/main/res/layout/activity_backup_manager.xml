<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Back up all your Tommy Arena data (notes, tasks, expenses, links, etc.) as a shareable file."
        android:textColor="@color/text_light" android:textSize="15sp" android:layout_marginBottom="20dp" />

    <Button android:id="@+id/btnBackupNow" style="@style/ToolButton" android:text="Backup Now &amp; Share" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Auto-backup reminder (weekly)" android:textColor="@color/text_light" />
        <Switch android:id="@+id/autoBackupSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:id="@+id/lastBackupText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/silver" android:textSize="12sp" android:layout_marginTop="16dp" />

</LinearLayout>
