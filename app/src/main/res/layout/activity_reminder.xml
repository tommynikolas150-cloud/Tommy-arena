<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="16dp">

    <EditText
        android:id="@+id/reminderInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Reminder text..."
        android:textColor="@color/text_light"
        android:textColorHint="#777777" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btnPickDateTime" style="@style/ToolButton" android:layout_width="0dp" android:layout_weight="1" android:text="Pick Date &amp; Time" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSetReminder"
        style="@style/ToolButton"
        android:text="Set Reminder"
        android:layout_marginTop="8dp" />

    <ListView
        android:id="@+id/reminderList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:divider="#333333"
        android:dividerHeight="1dp" />

</LinearLayout>
