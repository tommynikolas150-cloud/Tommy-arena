<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">

    <Button android:id="@+id/btnLoadVideos" style="@style/ToolButton" android:text="Load Videos" />
    <ListView android:id="@+id/videoList" android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_marginTop="8dp" android:divider="#333333" android:dividerHeight="1dp" />
    <VideoView android:id="@+id/videoPlayer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" />
</LinearLayout>
