<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_dark" android:padding="16dp">
    <TextView android:id="@+id/appCountText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/purple_primary" android:textSize="16sp" android:layout_marginBottom="8dp" />
    <ListView android:id="@+id/appsList" android:layout_width="match_parent" android:layout_height="match_parent"
        android:divider="#333333" android:dividerHeight="1dp" />
</LinearLayout>
